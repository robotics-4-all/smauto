Metadata
    name: HackathonExampleA
    version: "0.1.0"
    description: "Model of example 1 of the 2023 ISSEL hackathon"
    author: "klpanagi"
    email: "klpanagi@gmail.com"
end

RTMonitor
    broker: issel_cloud_platform
    namespace: "smauto.hackathod_a"
    eventTopic: "event"
    logsTopic: "logs"
end

Broker<MQTT> issel_cloud_platform
    host: "localhost"
    port: 1883
    auth:
        username: ""
        password: ""
end

Entity bedroom_humidifier
    type: actuator
    topic: "bedroom.humidifier"
    broker: issel_cloud_platform
    attributes:
        - power: bool
        - timer: int
end

Entity bedroom_humidity_sensor
    type: sensor
    topic: "bedroom.humidity"
    broker: issel_cloud_platform
    attributes:
        - humidity: float -> linear(0, 0.1) with noise gaussian(0, 0.05)
end

Entity bedroom_temperature_sensor
    type: sensor
    freq: 10
    topic: "bedroom.temperature"
    broker: issel_cloud_platform
    attributes:
        - temperature: float -> linear(20, 1) with noise gaussian(0, 0.05)
end

Entity kitchen_gas_sensor
    type: sensor
    freq: 10
    topic: "kitchen.gas"
    broker: issel_cloud_platform
    attributes:
        - gas: float -> linear(0, 0.1) with noise gaussian(0, 0.1)
end

Entity bedroom_aircondition
    type: actuator
    topic: "bedroom.aircondition"
    broker: issel_cloud_platform
    attributes:
        - power: bool
        - temperature: float
        - swing: bool
        - mode: str
end

Entity alarm
    type: actuator
    topic: "alarm"
    broker: issel_cloud_platform
    attributes:
        - state: int = 0
end

AUTO start_humidifier
WITH
    continuous: false
ON bedroom_humidity_sensor.humidity > 0.6
DO
    SET bedroom_humidifier.power: true
    SET bedroom_humidifier.timer: -1
    START stop_humidifier
;

AUTO stop_humidifier
WITH
    enabled: false
    continuous: false
ON bedroom_humidity_sensor.humidity < 0.3
DO
    SET bedroom_humidifier.power: false
    START start_humidifier
;

AUTO start_aircondition
WITH
    continuous: false
ON (bedroom_temperature_sensor.temperature > 28) AND
(bedroom_humidity_sensor.humidity in range [0.3, 0.6])
DO
    SET bedroom_aircondition.temperature:  25.0
    SET bedroom_aircondition.mode:  "cool"
    SET bedroom_aircondition.power:  true
;

AUTO set_alarm_on_gas
ON std(kitchen_gas_sensor.gas, 10) > 0.1
DO
    SET alarm.state:  1
;
