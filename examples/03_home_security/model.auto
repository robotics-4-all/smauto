Metadata
    name: HomeSecurity
    version: "0.1.0"
    description: "Home security system with time-based arming and intrusion detection."
    author: "smauto"
    email: "smauto@2023"
end

RTMonitor
    source: home_broker
    namespace: "smauto.security"
    eventTopic: "event"
    logsTopic: "logs"
end

Broker<MQTT> home_broker
    host: "localhost"
    port: 1883
    auth:
        username: ""
        password: ""
end

Entity motion_sensor
    type: sensor
    freq: 2
    uri: "hallway.motion"
    source: home_broker
    attributes:
        - detected: bool -> replay([false, false, false, true, false], -1)
end

Entity door_sensor
    type: sensor
    freq: 2
    uri: "front_door.contact"
    source: home_broker
    attributes:
        - open: bool -> replay([false, false, true, false], -1)
end

Entity alarm_siren
    type: actuator
    uri: "security.siren"
    source: home_broker
    attributes:
        - active: bool
        - volume: int = 0
end

Entity smart_lock
    type: actuator
    uri: "front_door.lock"
    source: home_broker
    attributes:
        - locked: bool
end

// Arm the security system every night at 10 PM
Automation arm_system
    when
        system_clock.time >= 22:00
    then
        smart_lock.locked <- true
    config
        description: "Arm security system at night"
        continuous: true
end

// Detect intrusion: motion OR door opened (only after system is armed)
Automation detect_intrusion
    when
        (arm_system.status == SUCCESS) AND
        ((motion_sensor.detected is true) OR
         (door_sensor.open is true))
    then
        alarm_siren.active <- true
        alarm_siren.volume <- 100
    config
        description: "Trigger alarm on intrusion detection"
        checkOnce: true
        continuous: false
end

// Disarm in the morning — silence alarm and unlock
Automation disarm_morning
    when
        system_clock.time >= 07:00
    then
        alarm_siren.active <- false
        alarm_siren.volume <- 0
        smart_lock.locked <- false
    config
        description: "Disarm security system in the morning"
        continuous: true
    terminates
        detect_intrusion
end
