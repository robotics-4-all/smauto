Metadata
    name: SimpleHomeAUTO
    version: "0.1.0"
    description: "Simple home automation model."
    author: "klpanagi"
    email: "klpanagi@gmail.com"
end

// Communication Brokers ------->
Broker<MQTT> cloud_platform_issel
    host: "localhost"
    port: 1883
    auth:
        username: ""
        password: ""
end

// Entities ------->
Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: cloud_platform_issel
    attributes:
        - power: bool
end

Entity motion_detector
    type: sensor
    topic: "bedroom.motion_detector"
    broker: cloud_platform_issel
    attributes:
        - detected: bool
        - posX: int
        - posY: int
        - mode: str
end


// Automations ------->
/*
AUTO motion_detected_1
WITH
    description: "This is an example automation"
    enabled: true
    continuous: true
ON motion_detector.pos == [10, 0]
DO
    SET bedroom_lamp.power: true
;
*/

AUTO motion_detected_1
WITH
    description: "This is an example automation"
    enabled: true
    continuous: true
ON (motion_detector.posX == 5) AND (motion_detector.posY == 0)
DO
    SET bedroom_lamp.power: true
;

AUTO motion_detected_2
WITH
    enabled: true
    continuous: true
ON motion_detector.detected is false
DO
    SET bedroom_lamp.power: true
;
