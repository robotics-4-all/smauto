Metadata
    name: SytemClockUsageExample
    version: "0.1.0"
    description: "Example of using the buildin SystemClock entity."
    author: "klpanagi"
    email: "klpanagi@gmail.com"
end


Broker<MQTT> home_broker
    host: "localhost"
    port: 1883
    auth:
        username: ""
        password: ""
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: fake_broker
    attributes:
        - power: bool
        - colorR: int
        - colorG: int
        - colorB: int
end

AUTO motion_detected_self_start
WITH
    enabled: true
    continuous: false
ON system_clock.time >= 03:06
DO
    SET bedroom_lamp.power: true
    START motion_detected_self_start
;
