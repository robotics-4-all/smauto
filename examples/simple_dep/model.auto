Metadata
    name: SimpleHomeAUTO
    version: "0.1.0"
    description: "Simple home automation model."
    author: "klpanagi"
    email: "klpanagi@gmail.com"
end

Broker<MQTT> cloud_platform_issel
    host: "localhost"
    port: 1883
    auth:
        username: ""
        password: ""
end

Entity bedroom_lamp
    type: actuator
    topic: "bedroom.lamp"
    broker: cloud_platform_issel
    attributes:
        - power: bool
end

Entity motion_detector
    type: sensor
    topic: "bedroom.motion_detector"
    broker: cloud_platform_issel
    attributes:
        - detected: bool
        - posX: int
        - pos: list
        - mode: str
end


AUTO motion_detected_1
WITH
    enabled: true
    continuous: true
ON motion_detector.pos == [10, 0]
DO
    SET bedroom_lamp.power: true
;


AUTO motion_detected_2
WITH
    enabled: true
    continuous: true
    after: motion_detected_1
ON (motion_detector.detected is true) AND
(motion_detector.posX == 10)
DO
    SET bedroom_lamp.power: true
;
