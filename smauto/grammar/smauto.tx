import automation
import communication
import constants
import entity
import types
import utils

SmAutoModel:
    imports*=Import
    (
    (metadata=Metadata)?
    (monitor=RTMonitor)?
    brokers*=MessageBroker
    endpoints*=RESTEndpoint
    constants*=ConstDef
    scenes*=SceneDef
    entities*=Entity
    groups*=EntityGroup
    automations*=Automation
    )#
;

Metadata:
    'Metadata'
    (
        ('name:' name=ID)
        ('version:' version=STRING)
        ('author:' author=STRING)?
        ('email:' email=STRING)?
        ('description:' description=STRING)?
    'end'
    )#
;

RTMonitor:
    'RTMonitor'
    (
        ('source:' source=[MessageBroker])
		('namespace:' ns=STRING)?
		('eventTopic:' eTopic=STRING)?
		('logsTopic:' lTopic=STRING)?
    'end'
    )#
;
