import entity
import condition
import types
import utils

// === Overall Automation ===
Automation:
    'AUTO' name=ID
    ('WITH'
        (
            ('description:' description=STRING)?
            ('freq:' freq=INT)?
            ('enabled:' enabled=BOOL)?
            ('continuous:' continuous=BOOL)?
            ('checkOnce:' checkOnce=BOOL)?
            ('delay:' delay=FLOAT)?
            ('after:' after*=[Automation:FQN|+m:automations][','])?
        )#
    )?
    'ON' condition=Condition
    'DO'
    actions*=Action
    ';'
;

AutomationDependency:
    automation=[Automation:FQN|+m:automations] ('on' exitStatus=BOOL)?
;


// === Actions ===
Action:
    SetAction | StartAction | StopAction
;

SetAction:
    FloatSetAction | IntSetAction | BoolSetAction | StringSetAction | ListSetAction | DictSetAction
;

IntSetAction:
    ('SET' attribute=[IntAttribute:FQN|+m:entities.attributes] ':' value=INT)
;

FloatSetAction:
    ('SET' attribute=[FloatAttribute:FQN|+m:entities.attributes] ':' value=STRICTFLOAT)
;

StringSetAction:
    ('SET' attribute=[StringAttribute:FQN|+m:entities.attributes] ':' value=STRING)
;

BoolSetAction:
    ('SET' attribute=[BoolAttribute:FQN|+m:entities.attributes] ':' value=BOOL)
;

ListSetAction:
    ('SET' attribute=[ListAttribute:FQN|+m:entities.attributes] ':' value=List)
;

DictSetAction:
    ('SET' attribute=[DictAttribute:FQN|+m:entities.attributes] ':' value=Dict)
;

StartAction:
    'START' automation=[Automation:FQN|+m:automations]
;

StopAction:
    'STOP' automation=[Automation:FQN|+m:automations]
;
