class SetAction:
    def __init__(self, attribute, value, entity):
        self.attribute = attribute
        self.value = value
        self.entity = entity


class WaitAction:
    def __init__(self, duration):
        self.duration = duration


class LogAction:
    def __init__(self, message, level='INFO'):
        self.message = message
        self.level = level


class HttpAction:
    def __init__(self, method, url, headers=None, body='', timeout=10):
        self.method = method
        self.url = url
        self.headers = headers or {}
        self.body = body
        self.timeout = timeout

    def execute(self):
        data = self.body.encode('utf-8') if self.body else None
        req = urllib.request.Request(
            self.url,
            data=data,
            headers=self.headers,
            method=self.method,
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                print(f'[HTTP] {self.method} {self.url} -> {resp.status}')
        except urllib.error.URLError as e:
            print(f'[HTTP] {self.method} {self.url} FAILED: {e}')


class ExprAction:
    """Action with a runtime-evaluated expression value."""
    _SAFE_BUILTINS = {
        'True': True, 'False': False, 'None': None,
        'abs': abs, 'round': round, 'int': int, 'float': float,
    }

    def __init__(self, attribute, expression, entity, entities_map):
        self.attribute = attribute
        self.expression = expression
        self.entity = entity
        self.entities_map = entities_map
        self._compiled = compile(expression, '<smauto-expr-action>', 'eval')

    @property
    def value(self):
        try:
            return eval(
                self._compiled,
                {'__builtins__': ExprAction._SAFE_BUILTINS, 'entities': self.entities_map},
                {},
            )
        except Exception as e:
            print(f'[ExprAction] Evaluation error: {e}')
            return 0


# ============================================================================
# Automation (ECA Rule)
# ============================================================================

class Automation:
    IDLE = 'IDLE'
    RUNNING = 'RUNNING'
    SUCCESS = 'SUCCESS'
    FAILED = 'FAILED'
    FINISHED = 'FINISHED'
    TERMINATED = 'TERMINATED'

    def __init__(self, name, condition, actions, else_actions, triggers, terminates,
                 freq, enabled, continuous, checkOnce, delay, cooldown,
                 entities, rtm=None):
        self.name = name
        self.condition = condition
        self.actions = actions
        self.else_actions = else_actions or []
        self.triggers = triggers
        self.terminates = terminates
        self.enabled = True if enabled is None else enabled
        self.continuous = True if continuous is None else continuous
        self.checkOnce = False if checkOnce is None else checkOnce
        self.freq = 1 if freq in (None, 0) else freq
        self.delay = 0 if delay is None else delay
        self.cooldown = 0 if cooldown is None else cooldown
        self.status = Automation.IDLE
        self.entities = entities
        self.autos_map = {}
        self.rtm = rtm

    def set_autos(self, autos_map):
        self.autos_map = autos_map

    def evaluate_condition(self):
        if self.enabled:
            return self.condition.evaluate(self.entities, self.autos_map)
        return False

    def print_info(self):
        trigs = '\n'.join(
            f"      - {self.autos_map[t].name}"
            for t in self.triggers
        ) or '      (none)'
        terms = '\n'.join(
            f"      - {self.autos_map[t].name}"
            for t in self.terminates
        ) or '      (none)'
        print(
            f"[bold]Automation <{self.name}>[/bold]\n"
            f"    Condition: {self.condition.expression}\n"
            f"    Frequency: {self.freq} Hz\n"
            f"    Continuous: {self.continuous}\n"
            f"    CheckOnce: {self.checkOnce}\n"
            f"    Delay: {self.delay}s\n"
            f"    Status: {self.status}\n"
            f"    Triggers:\n{trigs}\n"
            f"    Terminates:\n{terms}\n"
        )

    def _execute_actions(self, action_list):
        """Build and publish messages for a list of actions, with wait support."""
        messages = {}
        for action in action_list:
            if isinstance(action, HttpAction):
                action.execute()
                continue
            if isinstance(action, LogAction):
                self.log(action.message, action.level)
                continue
            if isinstance(action, WaitAction):
                # Flush pending messages before waiting
                for entity, message in messages.items():
                    entity.change_state(message)
                messages = {}
                self.log(f"Waiting {action.duration}s")
                time.sleep(action.duration)
                continue
            entity = action.entity
            if entity not in messages:
                messages[entity] = entity.dstate
            setattr(messages[entity], action.attribute, action.value)
        for entity, message in messages.items():
            entity.change_state(message)

    def trigger_actions(self):
        if not self.continuous:
            self.enabled = False
        self._execute_actions(self.actions)
        for auto_name in self.triggers:
            self.autos_map[auto_name].enable()
        for auto_name in self.terminates:
            self.autos_map[auto_name].terminate()

    def trigger_else_actions(self):
        """Execute the else branch actions (no trigger/terminate side-effects)."""
        if self.else_actions:
            self._execute_actions(self.else_actions)

    def enable(self):
        self.enabled = True
        self.log(f"Enabled Automation: {self.name}")

    def disable(self):
        self.enabled = False
        self.log(f"Disabled Automation: {self.name}")

    def terminate(self):
        self.enabled = False
        self.status = Automation.TERMINATED
        self.log(f"Terminated Automation: {self.name}")

    def send_event(self, msg=""):
        event = StateChangeMsg(state=self.status, msg=msg, automation=self.name)
        if self.rtm:
            self.rtm.send_event(event)

    def log(self, msg, level='INFO'):
        log_msg = LogMsg(msg=msg, level=level)
        if self.rtm:
            self.rtm.send_log(log_msg)
        print(f'[Automation: {self.name}] {msg}')

    def start(self):
        self.status = Automation.IDLE
        self.print_info()
        self.log(f"Starting Automation: {self.name}")
        _last_trigger_time = 0
        while not terminate_event.is_set():
            self.status = Automation.RUNNING
            self.send_event()
            try:
                if self.evaluate_condition():
                    # Cooldown check: skip if triggered too recently
                    if self.cooldown > 0:
                        elapsed = time.time() - _last_trigger_time
                        if elapsed < self.cooldown:
                            time.sleep(1 / self.freq)
                            continue
                    self.log(f"Condition met: {self.condition.expression}")
                    if self.delay > 0:
                        self.log(f"Delaying actions by {self.delay}s")
                        time.sleep(self.delay)
                    self.trigger_actions()
                    self.status = Automation.SUCCESS
                    self.send_event()
                    _last_trigger_time = time.time()
                else:
                    self.trigger_else_actions()
                if self.checkOnce:
                    self.disable()
                    self.status = Automation.FINISHED
                    self.send_event()
                time.sleep(1 / self.freq)
            except Exception as e:
                self.log(f'[ERROR] {e}')
                self.status = Automation.FAILED
                self.send_event()
                return
            if self.status in (Automation.SUCCESS, Automation.FINISHED):
                self.status = Automation.FINISHED
                self.send_event()
                self.status = Automation.IDLE


