class Executor(Node):
    def __init__(self, *args, **kwargs):
        self.name = '{{ metadata.name }}'
        {% if rt_monitor %}
        self.namespace = '{{ rt_monitor.ns }}'
        self.event_topic = '{{ rt_monitor.eTopic }}'
        self.logs_topic = '{{ rt_monitor.lTopic }}'
        {% endif %}

        self._broker_params = self._create_broker_params()

        {% if rt_monitor %}
        super().__init__(
            node_name=self.name,
            debug=True,
            connection_params=self._broker_params['{{ rt_monitor.source.name }}']
        )
        self._etopic = f'{self.namespace}.{self.event_topic}'
        self._ltopic = f'{self.namespace}.{self.logs_topic}'
        self.rtm = RTMonitor(self, self._etopic, self._ltopic)
        self.run()
        {% else %}
        self.rtm = None
        {% endif %}

        self.entities = self._create_entities()
        self.entities_map = {ent.name: ent for ent in self.entities}
        self.autos = self._create_automations(self.entities_map)
        self.autos_map = {auto.name: auto for auto in self.autos}
        for auto in self.autos:
            auto.set_autos(self.autos_map)

    def _create_broker_params(self):
        params = {}
        {% for broker in brokers %}
        {% if broker.__class__.__name__ == 'MQTTBroker' %}
        from commlib.transports.mqtt import ConnectionParameters
        params['{{ broker.name }}'] = ConnectionParameters(
            host='{{ broker.host }}',
            port={{ broker.port }},
            ssl={{ broker.ssl }},
            username='{{ broker.auth.username }}',
            password='{{ broker.auth.password }}',
        )
        {% elif broker.__class__.__name__ == 'AMQPBroker' %}
        from commlib.transports.amqp import ConnectionParameters
        params['{{ broker.name }}'] = ConnectionParameters(
            host='{{ broker.host }}',
            port={{ broker.port }},
            ssl={{ broker.ssl }},
            vhost='{{ broker.vhost }}',
            username='{{ broker.auth.username }}',
            password='{{ broker.auth.password }}',
        )
        {% elif broker.__class__.__name__ == 'RedisBroker' %}
        from commlib.transports.redis import ConnectionParameters
        params['{{ broker.name }}'] = ConnectionParameters(
            host='{{ broker.host }}',
            port={{ broker.port }},
            ssl={{ broker.ssl }},
            db={{ broker.db }},
            username='{{ broker.auth.username }}',
            password='{{ broker.auth.password }}',
        )
        {% endif %}
        {% endfor %}
        return params

    def _create_automations(self, entities):
        autos = []
        {% for auto in automations %}
        autos.append(Automation(
            name='{{ auto.name }}',
            condition=Condition(
                expression="{{ auto.condition.cond_lambda.replace('.value', '') }}",
                {% if auto.condition.cond_deactivate %}
                deactivate_expression="{{ auto.condition.cond_deactivate.replace('.value', '') }}",
                {% endif %}
                {% if auto.condition.forDuration %}
                for_duration={{ auto.condition.forDuration }},
                {% endif %}
            ),
            actions=[
            {% for action in auto.actions %}
                {% if action.__class__.__name__ == 'HttpAction' %}
                HttpAction('{{ action.method }}', '{{ action.url }}', {{ '{' }}{% for h in action.headers %}'{{ h.key }}': '{{ h.value }}'{% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }}, '{{ action.body }}', {{ action.timeout }}),
                {% elif action.__class__.__name__ == 'LogAction' %}
                LogAction('{{ action.message }}', '{{ action.level }}'),
                {% elif action.__class__.__name__ == 'WaitAction' %}
                WaitAction({{ action.duration }}),
                {% elif action.__class__.__name__ == 'ExprSetAction' %}
                ExprAction('{{ action.attribute.name }}', "{{ action.value }}", entities['{{ action.attribute.parent.name }}'], entities),
                {% elif action.attribute.type == "str" %}
                SetAction('{{ action.attribute.name }}', '{{ action.value }}', entities['{{ action.attribute.parent.name }}']),
                {% else %}
                SetAction('{{ action.attribute.name }}', {{ action.value }}, entities['{{ action.attribute.parent.name }}']),
                {% endif %}
            {% endfor %}
            ],
            else_actions=[
            {% for action in auto.elseActions %}
                {% if action.__class__.__name__ == 'HttpAction' %}
                HttpAction('{{ action.method }}', '{{ action.url }}', {{ '{' }}{% for h in action.headers %}'{{ h.key }}': '{{ h.value }}'{% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }}, '{{ action.body }}', {{ action.timeout }}),
                {% elif action.__class__.__name__ == 'LogAction' %}
                LogAction('{{ action.message }}', '{{ action.level }}'),
                {% elif action.__class__.__name__ == 'WaitAction' %}
                WaitAction({{ action.duration }}),
                {% elif action.__class__.__name__ == 'ExprSetAction' %}
                ExprAction('{{ action.attribute.name }}', "{{ action.value }}", entities['{{ action.attribute.parent.name }}'], entities),
                {% elif action.attribute.type == "str" %}
                SetAction('{{ action.attribute.name }}', '{{ action.value }}', entities['{{ action.attribute.parent.name }}']),
                {% else %}
                SetAction('{{ action.attribute.name }}', {{ action.value }}, entities['{{ action.attribute.parent.name }}']),
                {% endif %}
            {% endfor %}
            ],
            triggers=[
            {% for t in auto.triggers %}
                '{{ t.name }}',
            {% endfor %}
            ],
            terminates=[
            {% for t in auto.terminates %}
                '{{ t.name }}',
            {% endfor %}
            ],
            freq={{ auto.freq }},
            enabled={{ auto.enabled }},
            continuous={{ auto.continuous }},
            checkOnce={{ auto.checkOnce }},
            delay={{ auto.delay }},
            cooldown={{ auto.cooldown }},
            entities=entities,
            rtm=self.rtm
        ))
        {% endfor %}
        return autos

    def _create_entities(self):
        entities = []
    {% for e in entities %}
        entities.append(Entity(
            name='{{ e.name }}',
            topic='{{ e.uri }}',
            conn_params=self._broker_params['{{ e.source.name }}'],
            attributes={
            {% for attr in e.attributes %}
            {% if attr.type == "time" %}
                '{{ attr.name }}': Time(),
            {% else %}
                '{{ attr.name }}': {{ attr.type }}(),
            {% endif %}
            {% endfor %}
            },
            msg_type={{ e.camel_name }}Msg,
            attr_buff={{ e.attr_buffs }}
        ))
    {% endfor %}
        return entities

    def start_entities(self):
        for e in self.entities:
            e.start()

    def start_automations(self, max_workers=60):
        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            for automation in self.autos:
                executor.submit(automation.start).add_done_callback(
                    self._worker_clb
                )
        print('[bold magenta]All automations completed.[/bold magenta]')

    @staticmethod
    def _worker_clb(future):
        exc = future.exception()
        if exc is None:
            return
        trace = []
        tb = exc.__traceback__
        while tb is not None:
            trace.append({
                "filename": tb.tb_frame.f_code.co_filename,
                "name": tb.tb_frame.f_code.co_name,
                "lineno": tb.tb_lineno
            })
            tb = tb.tb_next
        print(f'[bold red]Worker error: {type(exc).__name__}: {exc}[/bold red]')
        for frame in trace:
            print(f'  {frame["filename"]}:{frame["lineno"]} in {frame["name"]}')


if __name__ == '__main__':
    signal.signal(signal.SIGINT, signal_handler)

    try:
        executor = Executor()
        executor.start_entities()
        executor.start_automations()
    except KeyboardInterrupt:
        print("[bold red]Keyboard interrupt. Shutting down...[/bold red]")
        terminate_event.set()
    except Exception as e:
        print(f"[bold red]Fatal error: {e}[/bold red]")
        terminate_event.set()
