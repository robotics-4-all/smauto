class Time(BaseModel):
    hour: int = 0
    minute: int = 0
    second: int = 0
    time_str: str = ''

    def to_int(self):
        return self.second + int(self.minute << 8) + int(self.hour << 16)


class ClockMsg(PubSubMessage):
    time: Time = Time()


