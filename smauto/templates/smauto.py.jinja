# Condition
# ============================================================================

class Condition:
    # Restricted builtins whitelist — no __import__, exec, open, etc.
    _SAFE_BUILTINS = {
        'True': True, 'False': False, 'None': None,
        'abs': abs, 'round': round, 'int': int, 'float': float,
        'bool': bool, 'len': len,
    }

    def __init__(self, expression, deactivate_expression=None, for_duration=0):
        self.expression = expression
        self._compiled = compile(expression, '<smauto-condition>', 'eval')
        self._deactivate = deactivate_expression
        self._compiled_deactivate = (
            compile(deactivate_expression, '<smauto-condition-deactivate>', 'eval')
            if deactivate_expression else None
        )
        self._hysteresis_active = False
        self.for_duration = for_duration
        self._duration_start = None

    @staticmethod
    def _delta(buf):
        if not buf or len(buf) < 2:
            return 0
        return buf[-1] - buf[0]

    @staticmethod
    def _rate(buf):
        if not buf or len(buf) < 2:
            return 0
        return (buf[-1] - buf[0]) / max(len(buf) - 1, 1)

    def _eval_expr(self, code, entities, automations):
        return eval(
            code,
            {
                '__builtins__': Condition._SAFE_BUILTINS,
                'entities': entities,
                'automations': automations,
            },
            {
                'std': statistics.stdev,
                'var': statistics.variance,
                'mean': statistics.mean,
                'min': min,
                'max': max,
                'delta': Condition._delta,
                'rate': Condition._rate,
            }
        )

    def _apply_duration_gate(self, raw_result):
        if not self.for_duration:
            return raw_result
        if raw_result:
            if self._duration_start is None:
                self._duration_start = time.time()
            if time.time() - self._duration_start >= self.for_duration:
                return True
            return False
        else:
            self._duration_start = None
            return False

    def evaluate(self, entities, automations=None):
        automations = automations or {}
        try:
            if self._compiled_deactivate is not None:
                if self._hysteresis_active:
                    if self._eval_expr(self._compiled_deactivate, entities, automations):
                        self._hysteresis_active = False
                        raw = False
                    else:
                        raw = True
                else:
                    raw = bool(self._eval_expr(self._compiled, entities, automations))
                    if raw:
                        self._hysteresis_active = True
            else:
                raw = bool(self._eval_expr(self._compiled, entities, automations))
            return self._apply_duration_gate(raw)
        except Exception as e:
            print(f'[Condition] Evaluation error: {e}')
            return False


